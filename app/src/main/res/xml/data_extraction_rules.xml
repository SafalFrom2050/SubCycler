<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- The calendar DataStore is in the file domain, outside both allowlists. -->
    <cloud-backup>
        <include domain="database" path="."/>
        <include domain="sharedpref" path="."/>
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="."/>
        <include domain="sharedpref" path="."/>
    </device-transfer>
</data-extraction-rules>
