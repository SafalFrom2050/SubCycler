<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget_container"
    android:clipToOutline="true">

    <!-- Neutral outer widget surface (tinted dynamically for Light/Dark) -->
    <ImageView
        android:id="@+id/widget_surface_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="fitXY"
        android:src="@drawable/bg_widget_inner_card"
        android:tintMode="src_in" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="10dp">

        <!-- Top rounded Hero card (clickable with native ripple) -->
        <FrameLayout
            android:id="@+id/widget_hero_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_widget_inner_card"
            android:clipToOutline="true"
            android:foreground="?android:attr/selectableItemBackground">

            <ImageView
                android:id="@+id/widget_hero_backdrop"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:scaleType="centerCrop" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="13dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/widget_swirl"
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:contentDescription="@null"
                            android:scaleType="fitCenter" />

                        <TextView
                            android:id="@+id/widget_eyebrow"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:layout_weight="1"
                            android:ellipsize="end"
                            android:fontFamily="sans-serif-medium"
                            android:letterSpacing="0.1"
                            android:maxLines="1"
                            android:text="EFFECTIVE MONTHLY"
                            android:textColor="@color/widget_text_secondary"
                            android:textSize="9sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/widget_monthly_amount"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:ellipsize="end"
                        android:fontFamily="sans-serif-black"
                        android:fontFeatureSettings="tnum"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:text="¥3,632"
                        android:textColor="@color/widget_text_primary"
                        android:textSize="26sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/widget_savings_subtitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:ellipsize="end"
                        android:fontFamily="sans-serif-medium"
                        android:maxLines="1"
                        android:text="Down from ¥4,290/mo · -15%"
                        android:textColor="@color/widget_text_secondary"
                        android:textSize="11sp" />

                    <ImageView
                        android:id="@+id/widget_efficiency_wave"
                        android:layout_width="136dp"
                        android:layout_height="11dp"
                        android:layout_marginTop="4dp"
                        android:contentDescription="@null"
                        android:scaleType="fitXY" />
                </LinearLayout>

                <FrameLayout
                    android:id="@+id/widget_seal_box"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:layout_marginStart="8dp">

                    <ImageView
                        android:id="@+id/widget_seal_bg"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@null"
                        android:scaleType="fitCenter"
                        android:src="@drawable/widget_cookie12_seal"
                        android:tintMode="src_in" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="5dp">

                        <TextView
                            android:id="@+id/widget_seal_top"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:includeFontPadding="false"
                            android:letterSpacing="0.07"
                            android:text="SAVE"
                            android:textColor="@color/widget_accent_on"
                            android:textSize="7.5sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/widget_seal_amount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="1dp"
                            android:ellipsize="end"
                            android:fontFamily="sans-serif-black"
                            android:fontFeatureSettings="tnum"
                            android:includeFontPadding="false"
                            android:maxLines="1"
                            android:text="¥7,894"
                            android:textColor="@color/widget_accent_on"
                            android:textSize="12.5sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/widget_seal_sub"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif"
                            android:includeFontPadding="false"
                            android:text="per year"
                            android:textColor="@color/widget_accent_on"
                            android:textSize="7.5sp" />
                    </LinearLayout>
                </FrameLayout>
            </LinearLayout>
        </FrameLayout>

        <!-- Bottom Connected Section Stack of up to 3 real native clickable service rows -->
        <LinearLayout
            android:id="@+id/widget_rows_container"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- Empty stack prompt -->
            <TextView
                android:id="@+id/widget_empty_rows_text"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:text="Tap to build your offline stack"
                android:textColor="@color/widget_text_secondary"
                android:textSize="12.5sp"
                android:visibility="gone" />

            <!-- Row 0 -->
            <FrameLayout
                android:id="@+id/widget_row_0"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:foreground="?android:attr/selectableItemBackground">

                <ImageView
                    android:id="@+id/widget_row_0_bg"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:scaleType="fitXY"
                    android:src="@drawable/bg_widget_row_top"
                    android:tintMode="src_in" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="10dp">

                    <ImageView
                        android:id="@+id/widget_row_0_badge"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:contentDescription="@null"
                        android:scaleType="fitCenter" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="9dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/widget_row_0_name"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:fontFamily="sans-serif-medium"
                            android:maxLines="1"
                            android:text="Disney+"
                            android:textColor="@color/widget_text_primary"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/widget_row_0_sub"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:fontFamily="sans-serif"
                            android:maxLines="1"
                            android:text="¥1,140 · 37d cycle"
                            android:textColor="@color/widget_text_secondary"
                            android:textSize="10.5sp" />
                    </LinearLayout>

                    <RelativeLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp">

                        <ImageView
                            android:id="@+id/widget_row_0_pill_bg"
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:layout_alignStart="@id/widget_row_0_pill_text"
                            android:layout_alignTop="@id/widget_row_0_pill_text"
                            android:layout_alignEnd="@id/widget_row_0_pill_text"
                            android:layout_alignBottom="@id/widget_row_0_pill_text"
                            android:contentDescription="@null"
                            android:scaleType="fitXY"
                            android:src="@drawable/bg_widget_pill_mask"
                            android:tintMode="src_in" />

                        <TextView
                            android:id="@+id/widget_row_0_pill_text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:maxLines="1"
                            android:paddingHorizontal="9dp"
                            android:paddingVertical="4dp"
                            android:text="2d left"
                            android:textSize="10.5sp"
                            android:textStyle="bold" />
                    </RelativeLayout>
                </LinearLayout>
            </FrameLayout>

            <!-- Row 1 -->
            <FrameLayout
                android:id="@+id/widget_row_1"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="3dp"
                android:layout_weight="1"
                android:foreground="?android:attr/selectableItemBackground">

                <ImageView
                    android:id="@+id/widget_row_1_bg"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:scaleType="fitXY"
                    android:src="@drawable/bg_widget_row_mid"
                    android:tintMode="src_in" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="10dp">

                    <ImageView
                        android:id="@+id/widget_row_1_badge"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:contentDescription="@null"
                        android:scaleType="fitCenter" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="9dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/widget_row_1_name"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:fontFamily="sans-serif-medium"
                            android:maxLines="1"
                            android:text="Netflix"
                            android:textColor="@color/widget_text_primary"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/widget_row_1_sub"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:fontFamily="sans-serif"
                            android:maxLines="1"
                            android:text="¥890 · 45d cycle"
                            android:textColor="@color/widget_text_secondary"
                            android:textSize="10.5sp" />
                    </LinearLayout>

                    <RelativeLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp">

                        <ImageView
                            android:id="@+id/widget_row_1_pill_bg"
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:layout_alignStart="@id/widget_row_1_pill_text"
                            android:layout_alignTop="@id/widget_row_1_pill_text"
                            android:layout_alignEnd="@id/widget_row_1_pill_text"
                            android:layout_alignBottom="@id/widget_row_1_pill_text"
                            android:contentDescription="@null"
                            android:scaleType="fitXY"
                            android:src="@drawable/bg_widget_pill_mask"
                            android:tintMode="src_in" />

                        <TextView
                            android:id="@+id/widget_row_1_pill_text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:maxLines="1"
                            android:paddingHorizontal="9dp"
                            android:paddingVertical="4dp"
                            android:text="8d left"
                            android:textSize="10.5sp"
                            android:textStyle="bold" />
                    </RelativeLayout>
                </LinearLayout>
            </FrameLayout>

            <!-- Row 2 -->
            <FrameLayout
                android:id="@+id/widget_row_2"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="3dp"
                android:layout_weight="1"
                android:foreground="?android:attr/selectableItemBackground">

                <ImageView
                    android:id="@+id/widget_row_2_bg"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:scaleType="fitXY"
                    android:src="@drawable/bg_widget_row_bottom"
                    android:tintMode="src_in" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="10dp">

                    <ImageView
                        android:id="@+id/widget_row_2_badge"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:contentDescription="@null"
                        android:scaleType="fitCenter" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="9dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/widget_row_2_name"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:fontFamily="sans-serif-medium"
                            android:maxLines="1"
                            android:text="Spotify"
                            android:textColor="@color/widget_text_primary"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/widget_row_2_sub"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:fontFamily="sans-serif"
                            android:maxLines="1"
                            android:text="¥980 · Always"
                            android:textColor="@color/widget_text_secondary"
                            android:textSize="10.5sp" />
                    </LinearLayout>

                    <RelativeLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp">

                        <ImageView
                            android:id="@+id/widget_row_2_pill_bg"
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:layout_alignStart="@id/widget_row_2_pill_text"
                            android:layout_alignTop="@id/widget_row_2_pill_text"
                            android:layout_alignEnd="@id/widget_row_2_pill_text"
                            android:layout_alignBottom="@id/widget_row_2_pill_text"
                            android:contentDescription="@null"
                            android:scaleType="fitXY"
                            android:src="@drawable/bg_widget_pill_mask"
                            android:tintMode="src_in" />

                        <TextView
                            android:id="@+id/widget_row_2_pill_text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:maxLines="1"
                            android:paddingHorizontal="9dp"
                            android:paddingVertical="4dp"
                            android:text="29d left"
                            android:textSize="10.5sp"
                            android:textStyle="bold" />
                    </RelativeLayout>
                </LinearLayout>
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
